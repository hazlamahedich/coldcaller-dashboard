# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coldcaller_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-in-production
BCRYPT_ROUNDS=12

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Google OAuth Configuration
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Microsoft OAuth Configuration
MICROSOFT_CALENDAR_CLIENT_ID=your-microsoft-calendar-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=your-microsoft-calendar-client-secret
OUTLOOK_EMAIL_CLIENT_ID=your-outlook-email-client-id
OUTLOOK_EMAIL_CLIENT_SECRET=your-outlook-email-client-secret

# Webhook Configuration
MICROSOFT_WEBHOOK_SECRET=your-microsoft-webhook-secret
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=3600

# Integration Service Configuration
INTEGRATION_SYNC_FREQUENCY=hourly
WEBHOOK_TIMEOUT_MS=5000
TOKEN_REFRESH_BUFFER_MINUTES=5

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=audio/mpeg,audio/wav,audio/ogg,application/pdf,text/plain

# Third-party Services
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Supabase Configuration (for vector storage)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Development Configuration
ENABLE_SWAGGER_DOCS=true
ENABLE_DEBUG_LOGGING=true
SKIP_AUTH_FOR_DEVELOPMENT=false