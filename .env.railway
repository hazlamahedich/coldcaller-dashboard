# Railway Production Environment Variables
# Copy these to your Railway dashboard environment variables section

# Application Environment
NODE_ENV=production
PORT=3001

# Frontend Configuration  
FRONTEND_URL=https://your-frontend-url.up.railway.app
CORS_ORIGIN=https://your-frontend-url.up.railway.app

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-change-this
BCRYPT_ROUNDS=12

# Supabase Configuration (use your existing values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Redis Configuration (Railway will provide these automatically)
# REDIS_URL will be automatically provided by Railway's Redis service

# AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL=gemini-1.5-pro-latest

# Twilio Configuration  
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Feature Flags
ENABLE_AUDIO_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_TWILIO_VOICE=true
ENABLE_SIP_INTEGRATION=true

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=audio/mpeg,audio/wav,audio/ogg,application/pdf,text/plain

# Chat Settings
CHAT_MAX_CONTEXT_LENGTH=4000
CHAT_MAX_RESPONSE_LENGTH=500
CHAT_SIMILARITY_THRESHOLD=0.7
CHAT_MAX_SOURCES=3

# Performance Configuration
CONNECTION_POOL_MIN=2
CONNECTION_POOL_MAX=10
CACHE_TTL=3600